{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stickermap",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static assets are free and unlimited; only these paths run the Worker (BUILD.md §4.1)
    "run_worker_first": ["/api/*", "/img/*", "/s/*", "/media/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stickermap",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "stickermap-photos" }],
  "vars": {
    // Turnstile always-pass test key for dev; replaced by the real site key at deploy
    "PUBLIC_TURNSTILE_SITEKEY": "1x00000000000000000000AA",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "CONTACT_EMAIL": "owner@example.com",
    // Public Worker only: /admin redirects to the Access-protected admin Worker (scripts/deploy-admin.ts clears it there)
    "ADMIN_ORIGIN": "https://admin.example.test"
  },
  // Reverse-geocode backfill, at most 4 Nominatim requests per run (BUILD.md §7.3b, §8)
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
