/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://tiles.openfreemap.org https://tiles.maps.eox.at; connect-src 'self' https://tiles.openfreemap.org https://photon.komoot.io https://nominatim.openstreetmap.org https://challenges.cloudflare.com; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/flags/*
  Cache-Control: public, max-age=31536000, immutable
