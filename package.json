{
  "name": "stickermap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mapa Papin: self-hosted sticker map (Cloudflare Workers + D1 + R2)",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/sql.js": "1.4.11",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "eslint": "10.13.0",
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@preact/signals": "2.11.3",
    "exifr": "7.1.3",
    "flag-icons": "7.6.0",
    "hono": "4.13.13",
    "idb": "8.0.4",
    "jose": "6.2.13",
    "lucide-static": "1.61.0",
    "maplibre-gl": "6.15.0",
    "preact": "11.0.2",
    "sql.js": "1.15.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "design": "tsx scripts/build-design.ts",
    "design:check": "tsx scripts/build-design.ts --check",
    "predev": "npm run design",
    "dev": "vite",
    "prebuild": "npm run design",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "extract": "python3 scripts/extract-fgdb.py",
    "migrate": "tsx scripts/migrate.ts"
  }
}
