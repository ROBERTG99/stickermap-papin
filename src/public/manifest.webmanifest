{
  "name": "Mapa Papin",
  "short_name": "Mapa Papin",
  "description": "Mapa global de los stickers papines",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#31872E",
  "background_color": "#31872E",
  "categories": ["social", "travel"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Agregar sticker", "url": "/nuevo", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Agregar varias fotos", "url": "/nuevo/varias", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photos", "accept": ["image/*"] }] }
  }
}
